generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://chat_app_xm5k_user:BMXFd77vjNEmlc8VIS5oFvgQicOvwgvL@dpg-d4bhsr0dl3ps739dha80-a.oregon-postgres.render.com:5432/chat_app_xm5k?sslmode=require"
}

model User {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  lastName   String?  @db.VarChar(100)
  email      String?  @unique @db.VarChar(100)
  password   String?  @db.VarChar(400)
  genderId   Int?     @db.SmallInt()
  phone      String?  @db.VarChar(100)
  birthDate  String?  @db.VarChar(50)
  isBot      Int      @default(0) @db.SmallInt()
  created_at DateTime @default(now()) @db.Timestamp()

  Message             Messages[]
  ConversationMembers ConversationMembers[]
  createByUser        Conversations[]
}

model Messages {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  text           String
  created_at     DateTime @default(now()) @db.Timestamp()

  sender       User          @relation(fields: [senderId], references: [id])
  conversation Conversations @relation(fields: [conversationId], references: [id])
}

model Conversations {
  id        Int      @id @default(autoincrement())
  type      String   @db.VarChar(50)
  name      String?  @db.VarChar(150)
  image     String?
  createBy  Int?
  create_at DateTime @default(now()) @db.Timestamp()

  createByUser        User?                 @relation(fields: [createBy], references: [id])
  messages            Messages[]
  ConversationMembers ConversationMembers[]
}

model ConversationMembers {
  id             Int      @id @default(autoincrement())
  userId         Int
  conversationId Int
  create_at      DateTime @default(now()) @db.Timestamp()

  conversation Conversations @relation(fields: [conversationId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
}
